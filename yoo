    <script>
    /* ===== SparkOS edition: 'standard' < 'beta' < 'founders' ===== */
    const EDITION = 'founders';
    /* Beta, Founders and Christmas 2026 builds are produced from this file when a code is redeemed.
       Grabbed here, before any script has touched the page. */
    let PRISTINE_SRC = '';
    if (EDITION === 'standard' || EDITION === 'founders') { try { PRISTINE_SRC = '<!DOCTYPE html>\n' + document.documentElement.outerHTML; } catch (e) {} }
    const RANK = { standard: 0, beta: 1, christmas: 1, founders: 2 }[EDITION] ?? 0;
    const IS_FOUNDER = EDITION === 'founders';
    const IS_XMAS = EDITION === 'christmas';
    const has = n => RANK >= n;
    const EFFECTS_BY = {
        standard: ['none', 'snow', 'stars'],
        beta: ['none', 'snow', 'stars', 'fireflies', 'rain', 'bubbles'],
        christmas: ['none', 'snow', 'stars', 'fireflies', 'embers', 'petals', 'sparkles', 'ornaments']
    };
    const WIDGETS_BY = {
        standard: ['notes', 'notebook', 'timer', 'calendar'],
        beta: ['notes', 'notebook', 'timer', 'calendar', 'todo', 'quote', 'weather', 'stopwatch'],
        christmas: ['notes', 'notebook', 'timer', 'calendar', 'todo', 'quote', 'weather']
    };
    const PRESETS_BY = {
        standard: ['aurora', 'sunset', 'ocean'],
        beta: ['aurora', 'sunset', 'ocean', 'forest', 'rose', 'graphite', 'nebula'],
        christmas: ['xmas-red', 'xmas-forest', 'xmas-gold', 'xmas-night', 'graphite']
    };
    const ENGINES_BY = {
        standard: ['google', 'ddg'],
        beta: ['google', 'ddg', 'bing', 'brave'],
        christmas: ['google', 'ddg', 'bing']
    };
    const CAPS = {
        standard: { maxApps: 12, maxFolders: 0, palette: false, themes: false, sounds: false },
        beta: { maxApps: 36, maxFolders: 10, palette: false, themes: false, sounds: true },
        christmas: { maxApps: 18, maxFolders: 4, palette: false, themes: false, sounds: true, xmas: true, maxZones: 0 },
        founders: { maxApps: Infinity, maxFolders: Infinity, palette: true, themes: true, sounds: true, maxThemes: 24, maxZones: 8, dualAccent: true, focusMode: true, denserFx: true }
    }[EDITION] || { maxApps: 12, maxFolders: 0, palette: false, themes: false, sounds: false };
    const allowEffect = e => IS_FOUNDER || (EFFECTS_BY[EDITION] || []).includes(e);
    const allowWidget = w => IS_FOUNDER || (WIDGETS_BY[EDITION] || []).includes(w);
    const allowPreset = n => IS_FOUNDER || (PRESETS_BY[EDITION] || []).includes(n);
    const allowEngine = e => IS_FOUNDER || (ENGINES_BY[EDITION] || []).includes(e);
    let appStorage = {};
    const WALLPAPER_FALLBACK = 'radial-gradient(circle at 80% 20%, #1e1b4b, #0f172a, #020617)';
    window.addEventListener('DOMContentLoaded', () => { 
        loadSettings(); focusSearch(); loadSavedApps(); loadSavedWallpaper(); loadSavedTitle(); initSystemClock(); loadDockStyles(); initLiquidGlass(); loadAccent(); sampleWallpaper(); initSettingsUI();
        if (IS_XMAS) { setupChristmas2026(); cleanXmasLegacy(); }
        
        // Rapid 400ms Launcher Transition Timeout Loop
        setTimeout(() => {
            const loader = document.getElementById('bootScreen');
            if(loader) {
                loader.style.opacity = '0';
                setTimeout(() => loader.style.visibility = 'hidden', 300);
            }
            maybeShowLockOnBoot();
        }, 400);
        initLockPad();
        syncLockUI();

    });

    /* Christmas 2026 limited edition defaults (only once per device) */
    function setupChristmas2026() {
        if (localStorage.getItem('viwinos_xmas2026_setup')) return;
        localStorage.setItem('viwinos_xmas2026_setup', '1');
        applyAccent('#ef4444');
        if (CAPS.dualAccent) applyAccent2('#22c55e');
        choosePreset('xmas-red');
        settings.effect = allowEffect('snow') ? 'snow' : 'none';
        settings.effectAmount = 70;
        settings.confetti = true;
        settings.bounce = true;
        settings.sounds = !!CAPS.sounds;
        settings.greeting = true;
        if (!settings.userName) settings.userName = '';
        saveSettings(); applySettings(); syncControls();
        // festive title if still default
        const t = document.getElementById('titleInput');
        if (t && (!t.value || t.value === 'SparkOS')) {
            t.value = 'SparkOS · Christmas';
            applyCustomTitle();
        }
    }
    
    /* ===== Accent colour + icon tint ===== */
    const DEFAULT_ACCENT = '#7c3aed';
    const WALLPAPER_GUESS = '#6366f1';   // used when the wallpaper colour can't be read
    let wallpaperColor = null, wallpaperReadable = false;

    function normHex(v) {
        v = (v || '').trim().replace(/^#/, '');
        if (/^[0-9a-f]{3}$/i.test(v)) v = v.split('').map(c => c + c).join('');
        return /^[0-9a-f]{6}$/i.test(v) ? '#' + v.toLowerCase() : null;
    }
    function hexToRgb(h) { const n = parseInt(h.slice(1), 16); return [n >> 16, (n >> 8) & 255, n & 255]; }
    function rgbToHex(r, g, b) { return '#' + [r, g, b].map(v => Math.round(v).toString(16).padStart(2, '0')).join(''); }
    function rgbToHsl(r, g, b) {
        r /= 255; g /= 255; b /= 255;
        const max = Math.max(r, g, b), min = Math.min(r, g, b), l = (max + min) / 2; let h = 0, s = 0;
        if (max !== min) {
            const d = max - min; s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            h = max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4; h /= 6;
        }
        return [h, s, l];
    }
    function hslToRgb(h, s, l) {
        if (s === 0) return [l * 255, l * 255, l * 255];
        const q = l < 0.5 ? l * (1 + s) : l + s - l * s, p = 2 * l - q;
        const f = t => { t = (t + 1) % 1; return 255 * (t < 1/6 ? p + (q - p) * 6 * t : t < 1/2 ? q : t < 2/3 ? p + (q - p) * (2/3 - t) * 6 : p); };
        return [f(h + 1/3), f(h), f(h - 1/3)];
    }

    function applyAccent(hex, fromTyping) {
        const h = normHex(hex); if (!h) return false;
        const [r, g, b] = hexToRgb(h), root = document.documentElement;
        root.style.setProperty('--accent', h); root.style.setProperty('--accent-rgb', `${r}, ${g}, ${b}`);
        localStorage.setItem('viwinos_accent', h);
        const picker = document.getElementById('accentPicker'); if (picker) picker.value = h;
        const field = document.getElementById('accentHex'); if (field && !fromTyping) field.value = h;
        updateTint(); if (typeof updateClear === 'function') updateClear();
        if (typeof applyCursor === 'function') applyCursor();
        return true;
    }
    function accentFromHexField(force) {
        const field = document.getElementById('accentHex'), raw = field.value.trim();
        const ok = normHex(raw);
        // apply live once the code is a complete 3- or 6-digit hex
        if (ok && (force || raw.replace('#','').length === 6 || raw.replace('#','').length === 3)) applyAccent(ok, !force);
        field.style.borderColor = (!raw || ok) ? '' : '#ef4444';
    }
    function loadAccent() { applyAccent(localStorage.getItem('viwinos_accent') || DEFAULT_ACCENT); }

    function tintMode() { return localStorage.getItem('viwinos_tint') || 'wallpaper'; }
    function cycleTint() {
        const next = { wallpaper: 'accent', accent: 'off', off: 'wallpaper' }[tintMode()] || 'wallpaper';
        localStorage.setItem('viwinos_tint', next); updateTint();
    }
    function updateTint() {
        const mode = tintMode(), root = document.documentElement;
        root.setAttribute('data-tint', mode); syncSeg('tint', mode);
        const btn = document.getElementById('tintToggle');
        if (btn) btn.innerText = 'Icon Tint: ' + ({ wallpaper: 'Wallpaper', accent: 'Accent', off: 'Off' }[mode]);
        if (mode === 'off') return;
        const base = mode === 'accent' ? (normHex(localStorage.getItem('viwinos_accent')) || DEFAULT_ACCENT) : (wallpaperColor || WALLPAPER_GUESS);
