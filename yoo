        .nb-book { position: relative; border-radius: 12px; padding: 10px 10px 8px 14px; background: linear-gradient(90deg, rgba(0,0,0,0.28) 0px, rgba(255,255,255,0.06) 8px, rgba(255,255,255,0.04) 100%); border: 1px solid rgba(255,255,255,0.16); box-shadow: inset 6px 0 12px rgba(0,0,0,0.32), 0 6px 18px rgba(0,0,0,0.22); transform-origin: left center; }
        .nb-book.flip-next { animation: nbFlipNext 0.36s cubic-bezier(0.22, 1, 0.36, 1); }
        .nb-book.flip-prev { animation: nbFlipPrev 0.36s cubic-bezier(0.22, 1, 0.36, 1); }
        @keyframes nbFlipNext { 0% { transform: rotateY(22deg) scale(0.98); opacity: 0.7; } 100% { transform: none; opacity: 1; } }
        @keyframes nbFlipPrev { 0% { transform: rotateY(-22deg) scale(0.98); opacity: 0.7; } 100% { transform: none; opacity: 1; } }
        .nb-date { font-size: 10.5px; color: rgba(255,255,255,0.52); margin-bottom: 2px; letter-spacing: 0.2px; }
        .nb-swipe-bar { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 6px; padding: 5px 8px; border-radius: 9px; background: rgba(255,255,255,0.06); border: 1px dashed rgba(255,255,255,0.18); font-size: 11px; color: rgba(255,255,255,0.72); cursor: grab; user-select: none; touch-action: none; }
        .nb-swipe-bar:active { cursor: grabbing; background: rgba(255,255,255,0.12); }
        .nb-nav-btn { border: none; background: rgba(255,255,255,0.1); color: #fff; border-radius: 6px; width: 22px; height: 20px; font-size: 13px; line-height: 1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
        .nb-nav-btn:hover { background: rgba(var(--accent-rgb), 0.55); }
        .nb-cover { cursor: grab; user-select: none; touch-action: none; }
        .nb-cover:active { cursor: grabbing; }
    </style>
