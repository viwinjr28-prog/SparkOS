                <feComponentTransfer in="mono" result="mono2"><feFuncA type="table" tableValues="0 0.12 0.5 0.8 0.92"/></feComponentTransfer>
                <feComposite in="mono2" in2="SourceAlpha" operator="in" result="shape"/>
                <feGaussianBlur in="shape" stdDeviation="0.9" result="bump"/>
