            toast('Renamed to “' + clean + '”');
        }
        applyProfileUI();
    }
    function renameActiveWorkspaceFromSettings() {
        const inp = document.getElementById('wsRenameInput');
        if (!inp) return;
        commitRenameWorkspace(activeProfile, inp.value);
    }
    function createWorkspace(customName) {
        const idx = workspaces.length + 1;
        let n = customName;
        if (n === undefined) {
            n = prompt('New workspace name:', 'Space ' + idx);
            if (n === null) return;
        }
        const name = (String(n).trim() || ('Space ' + idx)).slice(0, 24);
        const id = 'ws-' + Date.now().toString(36);
        workspaces.push({ id, name, pin: false });
        saveWorkspaces();
        switchProfile(id);
    }
    function createWorkspaceFromSettings() {
        const inp = document.getElementById('wsNewName');
        const val = inp ? inp.value.trim() : '';
        if (!val) { toast('Enter a workspace name first'); if (inp) inp.focus(); return; }
        inp.value = '';
        createWorkspace(val);
    }
    function deleteWorkspace(id) {
        if (workspaces.length <= 1) { toast('You need at least one workspace'); return; }
        const w = workspaces.find(x => x.id === id);
        if (!w) return;
        if (!confirm('Delete workspace “' + w.name + '” and its saved apps, notes, and settings?')) return;
        workspaces = workspaces.filter(x => x.id !== id);
        saveWorkspaces();
        try { localStorage.removeItem(profileBagKey(id)); idbDel('wallpaper:' + id); idbDel('font:' + id); idbDel('cursor:' + id); } catch (e) {}
        if (activeProfile === id) {
            const next = workspaces[0];
            activeProfile = next.id;
            localStorage.setItem(PROFILE_KEY, activeProfile);
            restoreProfile(activeProfile);
            reloadAfterProfileSwitch();
        } else {
            applyProfileUI();
        }
        toast('Deleted “' + w.name + '”');
    }
    function resetWorkspaceArea(id) {
        const w = workspaces.find(x => x.id === id);
        if (!w) return;
        if (!confirm('Reset workspace “' + w.name + '” back to defaults? (Only this workspace will be cleared.)')) return;
        try { localStorage.removeItem(profileBagKey(id)); idbDel('wallpaper:' + id); idbDel('font:' + id); idbDel('cursor:' + id); } catch (e) {}
        if (activeProfile === id) {
            restoreProfile(id);
            reloadAfterProfileSwitch();
        }
        toast('Reset “' + w.name + '”');
    }
    const WS_ICONS = {
        letter: null,
        home: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
        briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/>',
