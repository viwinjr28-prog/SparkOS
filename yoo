        headphones: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>',
        film: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 4v16M17 4v16M2 12h20M2 8h5M2 16h5M17 8h5M17 16h5"/>',
        camera: '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>',
        palette: '<circle cx="13.5" cy="6.5" r="1.2"/><circle cx="17.5" cy="10.5" r="1.2"/><circle cx="8.5" cy="7.5" r="1.2"/><circle cx="6.5" cy="12.5" r="1.2"/><path d="M12 2a10 10 0 1 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.3-.5-.8-.5-1.2 0-1.1.9-2 2-2h2.4a4.6 4.6 0 0 0 4.6-4.6C22 6 17.5 2 12 2z"/>',
        sparkles: '<path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17l-6.1 3.4 1.5-6.8L2.2 9l6.9-.7z"/>',
        rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>',
        flame: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
        bolt: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
        moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
        sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
        globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3.2 3.6 3.2 14.4 0 18M12 3c-3.2 3.6-3.2 14.4 0 18"/>',
        compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
        coffee: '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><path d="M6 2v3M10 2v3M14 2v3"/>',
        heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>',
        shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'
    };
    function renderWsGlyph(el, w) {
        const ic = w.icon && WS_ICONS[w.icon];
        if (ic) el.innerHTML = SVGW(ic);
        else el.textContent = wsFirstLetter(w.name);
    }
    function setWorkspaceIcon(id, iconKey) {
        const w = workspaces.find(x => x.id === id);
        if (!w) return;
        w.icon = iconKey;
        saveWorkspaces();
        closeWsIconPop();
        applyProfileUI();
    }
    function closeWsIconPop() {
        const p = document.getElementById('wsIconPop');
        if (p) p.classList.remove('open');
    }
    function openWsIconPop(anchorEl, w, x, y) {
        const p = document.getElementById('wsIconPop');
        if (!p) return;
        p.innerHTML = '';
        Object.entries(WS_ICONS).forEach(([k, path]) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'ws-icon-opt' + ((w.icon || 'letter') === k ? ' on' : '');
            b.title = k === 'letter' ? 'First letter' : k[0].toUpperCase() + k.slice(1);
            if (path) b.innerHTML = SVGW(path);
            else b.textContent = wsFirstLetter(w.name);
            b.onclick = e => { e.stopPropagation(); setWorkspaceIcon(w.id, k); };
            p.appendChild(b);
        });
        p.classList.add('open');
        const pw = p.offsetWidth, ph = p.offsetHeight;
        let px = x, py = y;
        if (anchorEl) {
            const r = anchorEl.getBoundingClientRect();
            px = r.right + 10;
            py = r.top;
            if (px + pw > innerWidth - 8) px = r.left - pw - 10;
        }
        p.style.left = Math.max(8, Math.min(px, innerWidth - pw - 8)) + 'px';
        p.style.top = Math.max(8, Math.min(py, innerHeight - ph - 8)) + 'px';
    }
    function showWsCtx(x, y, w) {
        document.getElementById('ctxTitle').innerText = w.name;
        const box = document.getElementById('ctxItems'); box.innerHTML = '';
        ctxAdd(box, 'Rename', 'pen', () => startRenameWorkspace(w.id));
        ctxAdd(box, 'Change icon…', 'sparkles', () => openWsIconPop(null, w, x, y));
        ctxAdd(box, w.pin ? 'Remove PIN lock' : 'PIN-protect', w.pin ? 'unlock' : 'lock', () => setProfilePinOn(w.id, !w.pin));
        ctxSep(box);
        ctxAdd(box, 'Reset area', 'out', () => resetWorkspaceArea(w.id));
        if (workspaces.length > 1) {
            ctxAdd(box, 'Delete', 'trash', () => deleteWorkspace(w.id), true);
        }
        const m = document.getElementById('ctxMenu'); m.style.display = 'flex';
        const mw = m.offsetWidth, mh = m.offsetHeight;
        m.style.left = Math.max(8, Math.min(x, innerWidth - mw - 8)) + 'px';
        m.style.top = Math.max(8, Math.min(y, innerHeight - mh - 8)) + 'px';
    }
    function wsFirstLetter(name) {
        return (name || '?').trim().slice(0, 1).toUpperCase();
    }
    function applyProfileUI() {
        const list = document.getElementById('wsList');
        if (list) {
            list.innerHTML = '';
            workspaces.forEach(w => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'ws-item' + (w.id === activeProfile ? ' on' : '');
                item.title = w.name + (w.pin ? ' (PIN protected)' : '') + ' · double-click or right-click to rename';
                renderWsGlyph(item, w);
                if (w.pin) {
                    const lk = document.createElement('span');
                    lk.className = 'ws-lock-dot';
                    lk.innerHTML = SVGW(PATHS.lock);
                    item.appendChild(lk);
                }
                item.onclick = () => requestProfile(w.id);
                item.ondblclick = e => { e.stopPropagation(); startRenameWorkspace(w.id); };
                item.oncontextmenu = e => { e.preventDefault(); e.stopPropagation(); showWsCtx(e.clientX, e.clientY, w); };
                list.appendChild(item);
            });
        }
        const sList = document.getElementById('wsSettingsList');
        if (sList) {
            sList.innerHTML = '';
            workspaces.forEach(w => {
                const isAct = w.id === activeProfile;
                const row = document.createElement('div');
                row.className = 's-app';
                const badge = document.createElement('div');
                badge.className = 'ws-s-badge clickable' + (isAct ? ' on' : '');
                badge.title = 'Click to change icon';
                renderWsGlyph(badge, w);
                badge.onclick = e => { e.stopPropagation(); openWsIconPop(badge, w, e.clientX, e.clientY); };
                row.appendChild(badge);

                const nm = document.createElement('div');
                nm.className = 'nm';
                nm.textContent = w.name;
                const sm = document.createElement('small');
                sm.textContent = (isAct ? 'Active' : 'Inactive') + (w.pin ? ' · PIN protected' : '');
                nm.appendChild(sm);
                row.appendChild(nm);

                if (!isAct) {
                    const swBtn = document.createElement('button');
                    swBtn.type = 'button'; swBtn.className = 's-btn'; swBtn.textContent = 'Switch';
                    swBtn.onclick = () => requestProfile(w.id);
                    row.appendChild(swBtn);
                }

                const acts = document.createElement('div');
                acts.className = 'acts';

                const pinBtn = document.createElement('button');
                pinBtn.type = 'button'; pinBtn.title = w.pin ? 'Remove PIN lock' : 'PIN-protect';
                pinBtn.innerHTML = SVGW(w.pin ? PATHS.lock : PATHS.unlock);
                pinBtn.onclick = () => setProfilePinOn(w.id, !w.pin);
                acts.appendChild(pinBtn);

                const renBtn = document.createElement('button');
                renBtn.type = 'button'; renBtn.title = 'Rename';
                renBtn.innerHTML = SVGW(PATHS.pen);
                renBtn.onclick = () => startRenameWorkspace(w.id);
                acts.appendChild(renBtn);

                const rstBtn = document.createElement('button');
                rstBtn.type = 'button'; rstBtn.title = 'Reset this workspace';
                rstBtn.innerHTML = SVGW(PATHS.out);
                rstBtn.onclick = () => resetWorkspaceArea(w.id);
                acts.appendChild(rstBtn);

                const delBtn = document.createElement('button');
                delBtn.type = 'button'; delBtn.className = 'del'; delBtn.title = 'Delete';
                delBtn.innerHTML = SVGW(PATHS.trash);
                if (workspaces.length <= 1) delBtn.disabled = true;
                delBtn.onclick = () => deleteWorkspace(w.id);
                acts.appendChild(delBtn);

                row.appendChild(acts);
                sList.appendChild(row);
            });
        }
    }
    function reloadAfterProfileSwitch() {
        try {
            closeFolder(); hideCtx(); hideSizeMenu();
            if (typeof customFace !== 'undefined' && customFace) { try { document.fonts.delete(customFace); } catch (e) {} customFace = null; }
            if (typeof curKey !== 'undefined') curKey = '';
            document.documentElement.classList.toggle('lg-off', localStorage.getItem('viwinos_liquid') === 'off');
            updateLgButton();
            loadSettings();
            loadSavedApps();
            loadSavedWallpaper();
            loadSavedTitle();
            loadDockStyles();
            loadAccent();
            if (typeof applyAccent2 === 'function' && CAPS.dualAccent) applyAccent2(getAccent2());
            applySettings();
            syncControls();
            if (typeof loadNotebook === 'function') { loadNotebook(); renderNotebook(); }
            if (typeof loadTodos === 'function') { loadTodos(); renderTodos(); }
            const notes = document.getElementById('notesArea');
            if (notes) { try { notes.value = localStorage.getItem('viwinos_notes') || ''; } catch (e) {} }
            if (typeof loadWidgetLayout === 'function') loadWidgetLayout();
            if (typeof renderThemes === 'function') renderThemes();
            sampleWallpaper();
            updateTint();
            applyWidgets();
            const cur = getWorkspace(activeProfile);
            toast((cur ? cur.name : 'Workspace') + ' workspace');
        } catch (e) {
            console.warn(e);
            location.reload();
        }
        applyProfileUI();
    }
    let wsSwitching = false;
    function switchProfile(id) {
        if (id === activeProfile || wsSwitching) return;
        const fade = document.getElementById('wsFade');
        const apply = () => {
            snapshotProfile(activeProfile);
            activeProfile = id;
            localStorage.setItem(PROFILE_KEY, id);
            restoreProfile(id);
            reloadAfterProfileSwitch();
        };
        if (!fade) { apply(); return; }
        wsSwitching = true;
        fade.classList.add('show');
        setTimeout(() => {
            apply();
            requestAnimationFrame(() => setTimeout(() => {
                fade.classList.remove('show');
                wsSwitching = false;
            }, 40));
        }, 190);
    }
    function requestProfile(id) {
        if (id === activeProfile) return;
        const w = getWorkspace(id);
        if (w && w.pin) {
            if (!localStorage.getItem(LOCK_PIN_KEY)) { toast('Set a PIN first'); promptSetPin(); return; }
            pendingProfile = id;
            profilePinMode = 'switch';
            showLockScreen();
            const sub = document.getElementById('lockSub');
            if (sub) sub.textContent = (hasBiometric() && window.PublicKeyCredential) ? 'Unlock ' + w.name + ' with Touch ID / Face ID or PIN' : 'Enter PIN to open ' + w.name;
            return;
        }
        switchProfile(id);
    }

    function maybeShowLockOnBoot() {
        loadWorkspaces();
        activeProfile = localStorage.getItem(PROFILE_KEY) || workspaces[0].id;
        if (!workspaces.some(w => w.id === activeProfile)) {
            activeProfile = workspaces[0].id;
            localStorage.setItem(PROFILE_KEY, activeProfile);
        }
        if (!localStorage.getItem(profileBagKey(activeProfile))) snapshotProfile(activeProfile);
        applyProfileUI();
        window.addEventListener('beforeunload', () => { if (localStorage.getItem(PROFILE_KEY) === activeProfile) snapshotProfile(activeProfile); });
        document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden' && localStorage.getItem(PROFILE_KEY) === activeProfile) snapshotProfile(activeProfile); });
        if (lockEnabled()) {
            pendingUpdateCheck = true;
            showLockScreen();
        } else {
            checkSparkUpdate();
        }
        syncLockUI();
    }
    const SPARKOS_VERSION = '10.0';
    const LAST_VER_KEY = 'viwinos_last_version';
    let pendingUpdateCheck = false;
    let updTimer = null;
    function cleanXmasLegacy() {
        if (!IS_XMAS || localStorage.getItem('viwinos_xmas_v8_clean')) return;
        localStorage.setItem('viwinos_xmas_v8_clean', '1');
        if (localStorage.getItem('viwinos_custom_desktop_title_v1') === 'SparkOS · Yule') {
            localStorage.setItem('viwinos_custom_desktop_title_v1', 'SparkOS · Christmas');
            loadSavedTitle();
        }
        if (settings.quote) {
            settings.quote = false;
            saveSettings(); applySettings(); syncControls();
        }
        Object.keys(localStorage).forEach(k => {
            if (!k.startsWith('viwinos_profile_bag_')) return;
            try {
                const bag = JSON.parse(localStorage.getItem(k) || '{}');
                let chg = false;
                if (bag.viwinos_custom_desktop_title_v1 === 'SparkOS · Yule') { bag.viwinos_custom_desktop_title_v1 = 'SparkOS · Christmas'; chg = true; }
                if (bag.viwinos_settings_v1) {
                    const s = JSON.parse(bag.viwinos_settings_v1);
                    if (s.quote) { s.quote = false; bag.viwinos_settings_v1 = JSON.stringify(s); chg = true; }
                }
                if (chg) localStorage.setItem(k, JSON.stringify(bag));
            } catch (e) {}
        });
    }
    function checkSparkUpdate() {
        cleanXmasLegacy();
        const prev = localStorage.getItem(LAST_VER_KEY);
        if (prev === SPARKOS_VERSION) return;
        localStorage.setItem(LAST_VER_KEY, SPARKOS_VERSION);
        const nm = (settings.userName || '').trim() || 'N/A';
        const t = document.getElementById('updTitle');
        const s = document.getElementById('updSub');
        const c = document.getElementById('updCard');
        if (!c) return;
        if (t) t.textContent = 'Your Spark Has Updated · v' + SPARKOS_VERSION;
        if (s) s.textContent = 'Name: ' + nm;
        c.classList.add('show');
        clearTimeout(updTimer);
        updTimer = setTimeout(closeUpdateBanner, 8000);
    }
    function closeUpdateBanner() {
        clearTimeout(updTimer);
        const c = document.getElementById('updCard');
        if (c) c.classList.remove('show');
    }

