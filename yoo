<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SparkOS Founders</title>
    <style>
        * { box-sizing: border-box; user-select: none; }
        /* fonts & cursors */
        html { cursor: var(--cur, auto); }
        html.cur-on :where(button, select, summary, label, a:any-link, input[type=checkbox], input[type=range], input[type=file]) { cursor: var(--cur-link, pointer); }
        html.font-all :where(button, input, select, textarea) { font-family: inherit; }
        .desktop-branding, .center-clock, .greeting { font-family: var(--clock-font, inherit); }
        .font-preview { flex: 1; font-family: var(--clock-font, inherit); font-size: 19px; line-height: 1.45; user-select: text; word-break: break-word; }
        body { 
            margin: 0; padding: 0; 
            background: radial-gradient(circle at 80% 20%, #1e1b4b, #0f172a, #020617);
            background-image: url('wallpapers/wallpaper.jpg'), radial-gradient(circle at 80% 20%, #1e1b4b, #0f172a, #020617);
            background-size: cover; background-position: center;
            font-family: var(--ui-font, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif); 
            height: 100vh; overflow: hidden; display: flex; flex-direction: column; align-items: center; 
        }

        /* Apple Style Quick 400ms Boot Screen Overlay */
        .boot-screen {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: #020617; display: flex; flex-direction: column;
            align-items: center; justify-content: center; z-index: 99999;
            transition: opacity 0.3s ease, visibility 0.3s;
        }
        .boot-logo { font-size: 3.5rem; font-weight: 700; color: white; letter-spacing: -2px; margin-bottom: 20px; }
        .boot-spinner {
            width: 28px; height: 28px; border: 3px solid rgba(255, 255, 255, 0.15);
            border-top-color: white; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 30px;
        }
        .boot-branding { position: absolute; bottom: 40px; font-size: 13px; font-weight: 500; color: rgba(255, 255, 255, 0.3); letter-spacing: 1px; text-transform: uppercase; }

        .safari-navbar {
            position: absolute; top: 40px; width: 55%; min-width: 400px;
            background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(40px) saturate(220%); -webkit-backdrop-filter: blur(40px) saturate(220%);
            border: 1px solid rgba(255, 255, 255, 0.22); padding: 8px 16px; border-radius: 18px;
            display: flex; align-items: center; justify-content: center; box-shadow: 0 15px 45px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.2); z-index: 1000;
        }
        .safari-url-field {
            width: 100%; background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 8px 16px; border-radius: 12px; color: rgba(255, 255, 255, 0.95); font-size: 14px; text-align: center; outline: none; user-select: text; transition: all 0.2s;
        }
        .safari-url-field:focus { background: rgba(0, 0, 0, 0.45); border-color: rgba(139, 92, 246, 0.6); text-align: left; }
        
        .brand-container { position: absolute; top: 35%; display: flex; flex-direction: column; align-items: center; pointer-events: none; }
        .desktop-branding { font-size: 5.5rem; font-weight: 700; color: rgba(255, 255, 255, 0.85); letter-spacing: -2px; text-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); margin: 0; text-align: center; }
        .center-clock { margin-top: 10px; color: rgba(255, 255, 255, 0.75); font-size: 1.8rem; font-weight: 600; text-shadow: 0 4px 15px rgba(0,0,0,0.3); letter-spacing: 0.5px; }

        .dock-wrapper { position: absolute; bottom: 25px; display: flex; justify-content: center; width: 100%; }
        .dock-container { 
            background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(45px) saturate(230%); -webkit-backdrop-filter: blur(45px) saturate(230%); 
            padding: 12px 20px; border-radius: 30px; display: flex; gap: 18px; 
            box-shadow: 0 30px 70px rgba(0,0,0,0.5), inset 0 1px 1px rgba(255,255,255,0.3); border: 1px solid rgba(255, 255, 255, 0.25); align-items: center; transition: all 0.3s ease;
        }
        .dock-icon { width: 54px; height: 54px; cursor: var(--cur-link, pointer); border-radius: 14px; transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275); filter: drop-shadow(0px 6px 10px rgba(0,0,0,0.25)); object-fit: cover; }
        .dock-icon:hover { transform: scale(1.24) translateY(-14px); }
        .dots-btn { width: 22px; height: 54px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 4px; cursor: var(--cur-link, pointer); padding: 0; opacity: 0.5; transition: opacity 0.2s; }
        .dots-btn:hover { opacity: 1; }
        .dot { width: 4px; height: 4px; background-color: white; border-radius: 50%; }

        /* Compact Ultra-Transparent Glass Dashboard Module Styles */
        .edit-panel {
            position: absolute; bottom: 90px; 
            background: rgba(20, 25, 40, 0.55); 
            backdrop-filter: blur(30px) saturate(180%); -webkit-backdrop-filter: blur(30px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 15px 40px rgba(0,0,0,0.5); 
            padding: 10px; border-radius: 16px; width: 250px; 
            display: none; flex-direction: column; gap: 6px; z-index: 5000;
        }
        .panel-title { color: white; font-weight: 600; font-size: 10px; letter-spacing: 0.5px; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 4px; }
        .panel-row { display: flex; flex-direction: column; gap: 2px; }
        .panel-label { color: rgba(255,255,255,0.6); font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }
        .panel-input { width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 5px; padding: 3px 6px; color: white; outline: none; font-size: 10px; user-select: text; }
        .panel-input:focus { border-color: #8b5cf6; }
        .panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
        .panel-btn { background: rgba(124, 92, 246, 0.85); color: white; border: none; padding: 5px; border-radius: 5px; cursor: var(--cur-link, pointer); font-weight: 600; font-size: 10px; transition: background 0.2s; text-align: center; }
        .panel-btn:hover { background: #6d28d9; }
        .panel-btn.danger { background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.25); }
        .panel-btn.danger:hover { background: rgba(239, 68, 68, 0.4); }


        /* ===== Apple Liquid Glass ===== */
        .dock-container { position: relative; }
        .safari-navbar, .dock-container, .edit-panel {
            --mx: 50%; --my: 0%;
            border: 1px solid rgba(255, 255, 255, 0.10);
            backdrop-filter: blur(10px) saturate(190%) brightness(1.12);
            -webkit-backdrop-filter: blur(10px) saturate(190%) brightness(1.12);
            box-shadow:
                0 18px 50px rgba(0, 0, 0, 0.35),
                0 2px 6px rgba(0, 0, 0, 0.18),
                inset 0 1px 0 rgba(255, 255, 255, 0.55),
                inset 0 -1px 0 rgba(255, 255, 255, 0.12),
                inset 0 0 22px rgba(255, 255, 255, 0.10),
                inset 0 -14px 24px -12px rgba(255, 255, 255, 0.16);
            background-image: linear-gradient(160deg, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0.04) 45%, rgba(255,255,255,0.10) 100%);
            background-color: rgba(255, 255, 255, 0.06);
        }
        .dock-container { background-color: transparent; }
        .edit-panel { background-color: rgba(28, 32, 52, 0.30); }

        /* bright curved rim (specular edge) */
        .safari-navbar::before, .dock-container::before, .edit-panel::before {
            content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1.3px; pointer-events: none;
            background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.08) 30%, rgba(255,255,255,0.02) 62%, rgba(255,255,255,0.65) 100%);
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude;
            opacity: 0.85;
        }
        /* light that follows the cursor */
        .safari-navbar::after, .dock-container::after, .edit-panel::after {
            content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
            background: radial-gradient(260px circle at var(--mx) var(--my), rgba(255,255,255,0.30), rgba(255,255,255,0.08) 40%, transparent 70%);
            opacity: 0; transition: opacity 0.35s ease; mix-blend-mode: soft-light;
        }
        .safari-navbar:hover::after, .dock-container:hover::after, .edit-panel:hover::after { opacity: 1; }

        .safari-url-field { background: rgba(0, 0, 0, 0.18); border: 1px solid rgba(255, 255, 255, 0.10); box-shadow: inset 0 2px 6px rgba(0,0,0,0.25), inset 0 -1px 0 rgba(255,255,255,0.12); }
        .dock-icon.icon-tile { object-fit: contain; padding: 8px; background: linear-gradient(160deg, #ffffff, #e6e8f0); }
        .dock-icon { box-shadow: 0 0 0 1px rgba(255,255,255,0.18), 0 8px 14px rgba(0,0,0,0.25); }

        /* real lens-style refraction (Chromium only; JS adds .lg-refract) */
        html.lg-refract .safari-navbar, html.lg-refract .dock-container, html.lg-refract .edit-panel {
            backdrop-filter: blur(5px) url(#lg-refract) saturate(190%) brightness(1.12);
        }
        /* user switched Liquid Glass off */
        html.lg-off .safari-navbar, html.lg-off .dock-container, html.lg-off .edit-panel {
            backdrop-filter: blur(30px) saturate(180%); -webkit-backdrop-filter: blur(30px) saturate(180%);
            background-image: none; box-shadow: 0 15px 40px rgba(0,0,0,0.4);
        }
        html.lg-off .safari-navbar::before, html.lg-off .safari-navbar::after,
        html.lg-off .dock-container::before, html.lg-off .dock-container::after,
        html.lg-off .edit-panel::before, html.lg-off .edit-panel::after { display: none; }

        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* ===== Accent colour + icon tint ===== */
        :root { --accent: #7c3aed; --accent-rgb: 124, 58, 237; }
        body::before {
            content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0;
            background: radial-gradient(circle at 82% 12%, rgba(var(--accent-rgb), 0.24), transparent 55%),
                        radial-gradient(circle at 12% 92%, rgba(var(--accent-rgb), 0.14), transparent 50%);
        }
        .safari-url-field:focus { border-color: rgba(var(--accent-rgb), 0.8); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.28); }
        .panel-input:focus { border-color: var(--accent); }
        input[type=range] { accent-color: var(--accent); }
        .panel-btn:not(.danger) { background: rgba(var(--accent-rgb), 0.85) !important; }
        .panel-btn:not(.danger):hover { background: var(--accent) !important; filter: brightness(1.15); }
        .safari-navbar { background-color: rgba(var(--accent-rgb), 0.12); }
        .edit-panel {
            background-color: rgba(var(--accent-rgb), 0.12);
            background-image: linear-gradient(rgba(12, 14, 28, 0.38), rgba(12, 14, 28, 0.38)),
                              linear-gradient(160deg, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0.04) 45%, rgba(255,255,255,0.10) 100%);
        }
        .safari-navbar::after, .dock-container::after, .edit-panel::after {
            background: radial-gradient(260px circle at var(--mx) var(--my), rgba(255,255,255,0.28), rgba(var(--accent-rgb), 0.16) 45%, transparent 72%);
        }
        .desktop-branding { text-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 46px rgba(var(--accent-rgb), 0.38); }
        .dock-icon:hover { box-shadow: 0 0 0 1px rgba(255,255,255,0.3), 0 12px 26px rgba(var(--accent-rgb), 0.55); }
        .panel-scroll { display: flex; flex-direction: column; gap: 6px; max-height: calc(100vh - 150px); overflow-y: auto; padding-right: 2px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.25) transparent; }
        /* tinted icons (duotone built from the accent / wallpaper colour) */
        html:not([data-tint="off"]) .viwinos-saved-app { filter: url(#viw-tint) drop-shadow(0px 6px 10px rgba(0,0,0,0.25)); }

        /* ===== Right-click app menu ===== */
        .ctx-menu {
            position: fixed; display: none; flex-direction: column; min-width: 160px; padding: 5px; z-index: 6000;
            background: rgba(24, 28, 44, 0.55); backdrop-filter: blur(30px) saturate(180%); -webkit-backdrop-filter: blur(30px) saturate(180%);
            border: 1px solid rgba(255,255,255,0.18); border-radius: 14px;
            box-shadow: 0 18px 45px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.25);
        }
        .ctx-title { padding: 5px 10px 6px; font-size: 10px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: rgba(255,255,255,0.5); border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 3px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ctx-item { padding: 7px 10px; font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.95); border-radius: 9px; cursor: var(--cur-link, pointer); display: flex; align-items: center; gap: 9px; }
        .ctx-item:hover { background: rgba(var(--accent-rgb), 0.75); }
        .ctx-item.danger { color: #fca5a5; }
        .ctx-item.danger:hover { background: rgba(239, 68, 68, 0.75); color: #fff; }
        .ctx-item svg { width: 15px; height: 15px; flex: none; }

        /* ===== Landscape control panel ===== */
        .edit-panel { width: min(720px, calc(100vw - 32px)); }
        .panel-cols { display: grid; grid-template-columns: repeat(3, 1fr); align-items: start; }
        .panel-col { display: flex; flex-direction: column; gap: 6px; padding: 0 12px; min-width: 0; }
        .panel-col:first-child { padding-left: 2px; }
        .panel-col:last-child { padding-right: 2px; }
        .panel-col + .panel-col { border-left: 1px solid rgba(255,255,255,0.09); }
        @media (max-width: 720px) {
            .panel-cols { grid-template-columns: 1fr; gap: 8px; }
            .panel-col, .panel-col:first-child, .panel-col:last-child { padding: 0; }
            .panel-col + .panel-col { border-left: none; border-top: 1px solid rgba(255,255,255,0.09); padding-top: 8px; }
        }

        /* ===== Settings window (macOS System Settings style) ===== */
        body::after { content: ''; position: fixed; inset: 0; background: #000; opacity: var(--wall-dim, 0); pointer-events: none; z-index: -1; }
        #fxCanvas { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
        .greeting { font-size: 1.7rem; font-weight: 600; letter-spacing: 0.2px; color: rgba(255,255,255,0.72); margin-bottom: 6px; text-shadow: 0 4px 14px rgba(0,0,0,0.35); }
        .greeting:empty { display: none; }
        .settings-overlay { position: fixed; inset: 0; z-index: 8000; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.38); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0.25s; }
        .settings-overlay.open { opacity: 1; visibility: visible; }
        .settings-win {
            width: min(920px, 94vw); height: min(600px, 86vh); display: flex; overflow: hidden; border-radius: 22px; color: #fff;
            background: rgba(28, 30, 42, 0.78); backdrop-filter: blur(50px) saturate(190%); -webkit-backdrop-filter: blur(50px) saturate(190%);
            border: 1px solid rgba(255,255,255,0.16);
            box-shadow: 0 40px 100px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.28), 0 0 60px rgba(var(--accent-rgb), 0.18);
            transform: scale(0.96) translateY(8px); transition: transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.2);
        }
        .settings-overlay.open .settings-win { transform: none; }
        .s-side { width: 250px; flex: none; display: flex; flex-direction: column; padding: 14px 12px; background: rgba(255,255,255,0.045); border-right: 1px solid rgba(255,255,255,0.09); }
        .s-lights { height: 22px; display: flex; align-items: center; padding-left: 4px; margin-bottom: 10px; }
        .light { width: 13px; height: 13px; border-radius: 50%; border: none; background: #ff5f57; cursor: var(--cur-link, pointer); padding: 0; box-shadow: inset 0 0 0 0.5px rgba(0,0,0,0.25); }
        .light:hover { filter: brightness(1.15); }
        .s-search { width: 100%; background: rgba(255,255,255,0.09); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 7px 11px; color: #fff; font-size: 13px; outline: none; user-select: text; margin-bottom: 12px; }
        .s-search:focus { border-color: rgba(var(--accent-rgb), 0.9); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.25); }
        .s-navlist { overflow-y: auto; flex: 1; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.2) transparent; }
        .s-group { margin-bottom: 16px; }
        .s-nav { display: flex; align-items: center; gap: 11px; padding: 6px 8px; border-radius: 10px; cursor: var(--cur-link, pointer); font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.94); }
        .s-nav:hover { background: rgba(255,255,255,0.08); }
        .s-nav.active { background: rgba(var(--accent-rgb), 0.9); box-shadow: 0 4px 14px rgba(var(--accent-rgb), 0.4); }
        .s-tile { width: 28px; height: 28px; border-radius: 8px; flex: none; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(160deg, #a1a1a8, #6b6b73); box-shadow: inset 0 1px 0 rgba(255,255,255,0.35), 0 1px 3px rgba(0,0,0,0.35); }
        .s-tile svg { width: 16px; height: 16px; }
        .s-tile.big { width: 40px; height: 40px; border-radius: 11px; }
        .s-tile.big svg { width: 23px; height: 23px; }
        .s-none { display: none; text-align: center; color: rgba(255,255,255,0.45); font-size: 13px; padding: 14px 0; }
        .s-main { flex: 1; min-width: 0; overflow-y: auto; padding: 22px 28px 28px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.2) transparent; }
        .s-pane { display: none; animation: paneIn 0.22s ease; }
        .s-pane.active { display: block; }
        @keyframes paneIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
        .s-head { display: flex; align-items: center; gap: 13px; margin-bottom: 18px; }
        .s-head h2 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.3px; }
        .s-cap { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.55); margin: 16px 4px 7px; letter-spacing: 0.2px; }
        .s-cap .hint { font-weight: 400; color: rgba(255,255,255,0.35); }
        .s-card { background: rgba(255,255,255,0.065); border: 1px solid rgba(255,255,255,0.09); border-radius: 13px; overflow: hidden; }
        .s-card.pad { padding: 12px; }
        .s-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 11px 15px; min-height: 48px; }
        .s-row + .s-row { border-top: 1px solid rgba(255,255,255,0.07); }
        .s-row.end { justify-content: flex-end; }
        .s-l { min-width: 0; }
        .s-lab { font-size: 14px; font-weight: 500; }
        .s-sub { font-size: 11.5px; color: rgba(255,255,255,0.48); margin-top: 2px; line-height: 1.3; }
        .s-c { display: flex; align-items: center; gap: 9px; flex: none; }
        .s-val { min-width: 40px; text-align: right; font-size: 12px; color: rgba(255,255,255,0.6); font-variant-numeric: tabular-nums; }
        .s-input { width: 160px; background: rgba(0,0,0,0.28); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 6px 10px; color: #fff; font-size: 13px; outline: none; user-select: text; }
        .s-input.wide { width: 230px; }
        .s-input.mono { width: 96px; font-family: ui-monospace, Menlo, monospace; }
        .s-input:focus, .s-select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.25); }
        .s-select { background: rgba(0,0,0,0.28); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 6px 10px; color: #fff; font-size: 13px; outline: none; cursor: var(--cur-link, pointer); }
        .s-select option { background: #1c1e2a; color: #fff; }
        .s-color { width: 38px; height: 28px; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; background: rgba(0,0,0,0.3); padding: 2px; cursor: var(--cur-link, pointer); }
        .s-range { width: 170px; accent-color: var(--accent); cursor: var(--cur-link, pointer); }
        .s-btn { background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 6px 13px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: var(--cur-link, pointer); transition: background 0.15s, transform 0.1s; white-space: nowrap; }
        .s-btn:hover { background: rgba(255,255,255,0.24); }
        .s-btn:active { transform: scale(0.97); }
        .s-btn.primary { background: var(--accent); border-color: transparent; }
        .s-btn.primary:hover { filter: brightness(1.15); background: var(--accent); }
        .s-btn.danger { background: rgba(239,68,68,0.18); border-color: rgba(239,68,68,0.35); color: #fecaca; }
        .s-btn.danger:hover { background: rgba(239,68,68,0.5); color: #fff; }
        .sw { position: relative; width: 40px; height: 24px; display: inline-block; flex: none; }
        .sw input { position: absolute; opacity: 0; width: 0; height: 0; }
        .sw span { position: absolute; inset: 0; background: rgba(255,255,255,0.2); border-radius: 24px; transition: background 0.2s; cursor: var(--cur-link, pointer); }
        .sw span::before { content: ''; position: absolute; width: 20px; height: 20px; left: 2px; top: 2px; background: #fff; border-radius: 50%; transition: transform 0.2s; box-shadow: 0 1px 4px rgba(0,0,0,0.4); }
        .sw input:checked + span { background: var(--accent); }
        .sw input:checked + span::before { transform: translateX(16px); }
        .seg { display: inline-flex; background: rgba(0,0,0,0.28); border-radius: 9px; padding: 2px; }
        .seg button { background: none; border: none; color: rgba(255,255,255,0.7); padding: 5px 12px; font-size: 12.5px; font-weight: 600; border-radius: 7px; cursor: var(--cur-link, pointer); }
