"s-tile big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg></div><h2>Home Screen</h2></div><div class="s-cap">Text</div><div class="s-card"><div class="s-row"><div class="s-l"><div class="s-lab">Title</div></div><div class="s-c"><input type="text" class="s-input" id="titleInput" placeholder="SparkOS" oninput="applyCustomTitle()"></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Greeting</div><div class="s-sub">e.g. “Good evening, Sam”</div></div><div class="s-c"><label class="sw"><input type="checkbox" data-s="greeting"><span></span></label></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Your name</div></div><div class="s-c"><input type="text" class="s-input" data-s="userName" placeholder="Optional" maxlength="20"></div></div></div><div class="s-cap">Clock</div><div class="s-card"><div class="s-row"><div class="s-l"><div class="s-lab">24-hour clock</div></div><div class="s-c"><label class="sw"><input type="checkbox" data-s="clock24"><span></span></label></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Show seconds</div></div><div class="s-c"><label class="sw"><input type="checkbox" data-s="showSeconds"><span></span></label></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Show date</div></div><div class="s-c"><label class="sw"><input type="checkbox" data-s="showDate"><span></span></label></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Clock size</div></div><div class="s-c"><input type="range" class="s-range" data-s="clockSize" data-unit="%" min="40" max="250"><span class="s-val" id="v_clockSize"></span></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Title size</div></div><div class="s-c"><input type="range" class="s-range" data-s="titleSize" data-unit="%" min="40" max="250"><span class="s-val" id="v_titleSize"></span></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Show title</div></div><div class="s-c"><label class="sw"><input type="checkbox" data-s="showTitle"><span></span></label></div></div></div></section><section class="s-pane" id="pane-dock"><div class="s-head"><div class="s-tile big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="15" width="18" height="5" rx="2.5"/><rect x="6" y="6" width="4" height="4" rx="1"/><rect x="14" y="6" width="4" height="4" rx="1"/></svg></div><h2>Dock</h2></div><div class="s-cap">Dock</div><div class="s-card"><div class="s-row"><div class="s-l"><div class="s-lab">Dock opacity</div></div><div class="s-c"><input type="range" class="s-range" id="dockOpacity" min="10" max="100" value="15" oninput="adjustDock()"></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Dock size</div></div><div class="s-c"><input type="range" class="s-range" id="dockScale" min="70" max="130" value="100" oninput="adjustDock()"></div></div><div class="s-row" data-tier="1"><div class="s-l"><div class="s-lab">Auto-hide dock</div><div class="s-sub">Slides away; move your mouse to the bottom edge to bring it back</div></div><div class="s-c"><label class="sw"><input type="checkbox" data-s="autoHide"><span></span></label></div></div><div class="s-row"><div class="s-l"><div class="s-lab">Lift icons on hover</div></div><div class="s-c"><label class="sw"><input type="checkbox" data-s="hoverLift"><span></span></label></div></div></div></section><section class="s-pane" id="pane-apps"><div class="s-head"><div class="s-tile big"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><rect x="14" y="14" width="6" height="6" rx="1.5"/></s